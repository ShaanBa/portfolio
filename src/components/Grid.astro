---
export interface GridItem {
  id: string;
  title: string;
  category: string;
  description: string;
  metrics?: string[];
  techStack?: string[];
  linkUrl?: string;
  colSpan?: 'full' | 'half' | 'third' | 'two-thirds';
}

interface Props {
  sectionNumber?: string;
  sectionTitle?: string;
  metaLabel?: string;
  items?: GridItem[];
}

const {
  sectionNumber = "03",
  sectionTitle = "Concurrency & Dual-DB Engines",
  metaLabel = "Project Ledger",
  items = []
} = Astro.props;

const noiseDataUri = "data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E";

function getColSpanClass(span?: string) {
  switch (span) {
    case 'full': return 'col-full';
    case 'half': return 'col-half';
    case 'third': return 'col-third';
    case 'two-thirds': return 'col-two-thirds';
    default: return 'col-half';
  }
}
---

<section class="editorial-grid-section">
  <div class="noise-overlay" style={`background-image: url("${noiseDataUri}")`}></div>

  <div class="grid-container">
    {/* Section Header */}
    <div class="section-header">
      <div>
        <div class="header-meta">
          <span class="idx-badge">{sectionNumber}</span>
          <span class="meta-label">{metaLabel}</span>
        </div>
        <h2 class="section-title">{sectionTitle}</h2>
      </div>
    </div>

    {/* Grid Items */}
    <slot>
      {items.length > 0 && (
        <div class="items-grid">
          {items.map((item, idx) => (
            <article class={`grid-card ${getColSpanClass(item.colSpan)}`}>
              <div>
                <div class="card-top">
                  <span class="card-cat font-mono">
                    {item.category}
                  </span>
                  {item.linkUrl && (
                    <a href={item.linkUrl} target="_blank" rel="noopener noreferrer" class="card-link font-mono">
                      Visit &rarr;
                    </a>
                  )}
                </div>

                <h3 class="card-title">
                  {item.title}
                </h3>

                <p class="card-desc">
                  {item.description}
                </p>
              </div>

              <div>
                {item.metrics && item.metrics.length > 0 && (
                  <div class="metrics-block">
                    {item.metrics.map((m, mIdx) => (
                      <div class="metric-row font-mono">
                        <span class="metric-num">0{mIdx + 1}</span>
                        <span>{m}</span>
                      </div>
                    ))}
                  </div>
                )}

                {item.techStack && item.techStack.length > 0 && (
                  <div class="tech-wrap">
                    {item.techStack.map((tech) => (
                      <span class="tech-tag font-mono">{tech}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </slot>
  </div>
</section>

<style>
  @import url('https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=cabinet-grotesk@400,500,700,800&f[]=sentient@400,400i,500,700,700i&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:ital,wght@0,300..700;1,300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');

  .editorial-grid-section {
    position: relative;
    width: 100%;
    background-color: #082c1d;
    color: #f5f2eb;
    border-left: 1px solid rgba(6, 78, 59, 0.4);
    border-right: 1px solid rgba(6, 78, 59, 0.4);
    border-bottom: 1px solid rgba(6, 78, 59, 0.4);
    border-radius: 0 !important;
    padding-top: 4rem;
    padding-bottom: 4rem;
    max-width: 1720px;
    margin: 0 auto;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .editorial-grid-section {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  .noise-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    opacity: 0.045;
  }

  .grid-container {
    position: relative;
    z-index: 20;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  @media (min-width: 1024px) {
    .grid-container {
      padding-left: 4rem;
      padding-right: 4rem;
    }
  }

  .section-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid rgba(6, 78, 59, 0.5);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .idx-badge {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 11px;
    background-color: #06140e;
    color: #00ff87;
    border: 1px solid rgba(6, 78, 59, 0.5);
    padding: 2px 6px;
    border-radius: 0 !important;
  }

  .meta-label {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4af37;
  }

  .section-title {
    font-family: 'Instrument Serif', 'Sentient', serif;
    font-size: 42px;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: #f5f2eb;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .section-title {
      font-size: 56px;
    }
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid rgba(6, 78, 59, 0.5);
    border-left: 1px solid rgba(6, 78, 59, 0.5);
  }

  .grid-card {
    border-right: 1px solid rgba(6, 78, 59, 0.5);
    border-bottom: 1px solid rgba(6, 78, 59, 0.5);
    padding: 2rem;
    background-color: #0b3826;
    border-radius: 0 !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background-color 0.2s ease;
  }

  .grid-card:hover {
    background-color: #06140e;
  }

  @media (min-width: 1024px) {
    .grid-card {
      padding: 3rem;
    }
  }

  .col-full { grid-column: span 12 / span 12; }
  .col-half { grid-column: span 12 / span 12; }
  .col-third { grid-column: span 12 / span 12; }
  .col-two-thirds { grid-column: span 12 / span 12; }

  @media (min-width: 1024px) {
    .col-half { grid-column: span 6 / span 6; }
    .col-third { grid-column: span 4 / span 4; }
    .col-two-thirds { grid-column: span 8 / span 8; }
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .card-cat {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4af37;
  }

  .card-link {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 12px;
    color: #00ff87;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-link:hover {
    color: #d4af37;
  }

  .card-title {
    font-family: 'Instrument Serif', 'Sentient', serif;
    font-size: 32px;
    line-height: 1.1;
    color: #f5f2eb;
    margin: 0 0 1rem 0;
    transition: color 0.2s ease;
  }

  .grid-card:hover .card-title {
    color: #d4af37;
  }

  @media (min-width: 1024px) {
    .card-title {
      font-size: 40px;
    }
  }

  .card-desc {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1rem;
    line-height: 1.625;
    color: #dcd8ce;
    margin: 0 0 2rem 0;
  }

  .metrics-block {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: #06140e;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-row {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 12px;
    color: #00ff87;
    letter-spacing: 0.05em;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .metric-num {
    color: #d4af37;
    font-size: 11px;
  }

  .tech-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(6, 78, 59, 0.5);
  }

  .tech-tag {
    font-family: 'JetBrains Mono', 'Space Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #dcd8ce;
    background-color: #082c1d;
    border: 1px solid rgba(6, 78, 59, 0.5);
    padding: 2px 6px;
    border-radius: 0 !important;
  }
</style>
