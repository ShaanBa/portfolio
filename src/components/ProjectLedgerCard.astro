---
export interface ProjectItem {
  id: string;
  title: string;
  category: string;
  summary: string;
  bullets?: string[];
  techStack: string[];
  url?: string;
  githubUrl?: string;
}

interface Props {
  project: ProjectItem;
  index?: number;
}

const { project, index = 1 } = Astro.props;
const { title, category, summary, bullets = [], techStack = [], url, githubUrl } = project;
const displayIndex = String(index).padStart(2, '0');
---

<article class="project-ledger-card panel">
  <header class="card-strip">
    <span class="strip-label font-mono">{displayIndex}&nbsp;&nbsp;{category}</span>
  </header>

  <div class="card-main">
    <div class="card-title-row">
      <h3 class="project-title">{title}</h3>
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="visit-link" aria-label={`Visit ${title}`}>
          &nearr;
        </a>
      )}
    </div>

    <div class="summary-field">
      <p class="project-summary">{summary}</p>
    </div>

    {bullets && bullets.length > 0 && (
      <div class="bullet-ledger">
        {bullets.map((item, bIdx) => (
          <div class="rationale-item font-sans">
            <span class="item-index font-mono">0{bIdx + 1}</span>
            <span class="item-text">{item}</span>
          </div>
        ))}
      </div>
    )}

    <div class="tech-stack-row">
      {techStack.map((tech) => (
        <span class="pill font-mono">{tech}</span>
      ))}
    </div>
  </div>

  {(url || githubUrl) && (
    <footer class="card-actions">
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class="action-primary">View Project &rarr;</a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="action-secondary">Source Code &rarr;</a>
      )}
    </footer>
  )}
</article>

<style>
  .project-ledger-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--surface-panel);
    border: 2px solid var(--border-outline);
    box-shadow: var(--shadow-panel);
    margin-bottom: 24px;
  }

  .card-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background: var(--bg-base);
    border-bottom: 2px solid var(--border-outline);
  }

  .strip-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-accent);
  }

  .card-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 24px;
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .project-title {
    font-family: var(--font-header);
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    color: var(--ink);
    line-height: 1.3;
  }

  .visit-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 2px solid var(--primary-accent);
    color: var(--primary-accent);
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .visit-link:hover {
    background: var(--primary-accent);
    color: #ffffff;
  }

  .summary-field {
    border-top: 1px solid var(--border-outline);
    padding-top: 1rem;
  }

  .project-summary {
    color: var(--ink-soft);
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
  }

  .bullet-ledger {
    border-top: 1px solid var(--border-outline);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rationale-item {
    display: flex;
    gap: 0.875rem;
    align-items: baseline;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink);
  }

  .item-index {
    font-family: var(--font-mono);
    color: var(--primary-accent);
    font-weight: 600;
    flex-shrink: 0;
    font-size: 11.5px;
  }

  .item-text {
    flex: 1;
  }

  .tech-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-outline);
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border: 1.5px solid var(--border-outline);
    background: var(--bg-base);
    color: var(--ink-soft);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .card-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 14px 24px;
    border-top: 2px solid var(--border-outline);
    background: var(--bg-base);
  }

  .action-primary {
    font-family: var(--font-header);
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 16px;
    text-decoration: none;
    border: 2px solid var(--primary-accent);
    color: var(--ink);
    background: transparent;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .action-primary:hover {
    background: var(--primary-accent);
    color: #ffffff;
  }

  .action-secondary {
    font-family: var(--font-header);
    font-weight: 600;
    font-size: 13.5px;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .action-secondary:hover {
    color: var(--primary-accent);
    text-decoration: underline;
  }
</style>
