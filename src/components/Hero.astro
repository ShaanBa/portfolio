---
interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  projectsCount?: number;
  primaryCtaText?: string;
  primaryCtaUrl?: string;
  secondaryCtaText?: string;
  secondaryCtaUrl?: string;
}

const {
  kicker = "Full-Stack & Backend Engineer",
  title = "Shaan Bawa",
  subtitle = "Full-stack and backend engineer who builds dual-database systems, concurrent Postgres transaction engines, and payment infrastructure that has to be right the first time.",
  projectsCount = 4,
  primaryCtaText = "Get in Touch",
  primaryCtaUrl = "#contact",
  secondaryCtaText = "See the Work",
  secondaryCtaUrl = "#work"
} = Astro.props;

const stats = [
  { label: "Experience", value: "Since 2019" },
  { label: "Projects Built", value: `${projectsCount} Projects` },
  { label: "Core Focus", value: "Concurrency & DBs" },
  { label: "Status", value: "Available 2026" }
];
---

<section class="panel hero">
  <div class="band">
    <div class="kicker">{kicker}</div>
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </div>

  <div class="stats-row">
    {stats.map((stat) => (
      <div class="stat-item">
        <span class="stat-label">{stat.label}</span>
        <span class="stat-val">{stat.value}</span>
      </div>
    ))}
  </div>

  <div class="foot">
    <a href={primaryCtaUrl} class="cta primary-cta">{primaryCtaText}</a>
    <a href={secondaryCtaUrl} class="cta secondary-cta">{secondaryCtaText}</a>
  </div>
</section>

<style>
  .hero {
    padding: 0;
    overflow: hidden;
    background: var(--surface-panel);
    border: 2px solid var(--border-outline);
    box-shadow: var(--shadow-panel);
  }

  .band {
    background: var(--primary-accent);
    color: #ffffff;
    padding: 44px 32px 40px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.95;
    margin-bottom: 14px;
  }

  .hero h1 {
    font-family: var(--font-header);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px;
    max-width: 700px;
    color: #ffffff;
  }

  .hero p {
    font-family: var(--font-header);
    max-width: 640px;
    opacity: 0.95;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    background: var(--surface-panel);
    border-top: 2px solid var(--border-outline);
    border-bottom: 2px solid var(--border-outline);
  }

  @media (min-width: 640px) {
    .stats-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat-item {
    padding: 16px 20px;
    border-right: 2px solid var(--border-outline);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-item:last-child {
    border-right: none;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .foot {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
    align-items: center;
    padding: 16px 20px;
    background: var(--bg-base);
  }

  .cta {
    font-family: var(--font-header);
    font-weight: 700;
    font-size: 14px;
    padding: 11px 22px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .primary-cta {
    background: var(--primary-accent);
    color: #ffffff;
    border: 2px solid var(--primary-accent);
  }

  .primary-cta:hover {
    background: var(--blue-dark);
    border-color: var(--blue-dark);
  }

  .secondary-cta {
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--border-outline);
  }

  .secondary-cta:hover {
    border-color: var(--primary-accent);
    color: var(--primary-accent);
  }

  .primary-cta::after, .secondary-cta::after {
    content: " \2192";
  }
</style>
